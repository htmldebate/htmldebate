---
import { site } from '../config/site';

// `searchTitle` is what search results and shared links show: what someone would search for, where the page's own name can
// rely on the page around it.
interface Props {
    readonly searchTitle: string;
    readonly description: string;
    readonly path: string;
    readonly isHidden: boolean;
}

const { searchTitle, description, path, isHidden }: Props = Astro.props;
const fullTitle: string = `${searchTitle} | ${path === '/' ? site.name : site.shortName}`;
const canonical: string = new URL(path, site.url).href;
const image: string = new URL(site.socialImage, site.url).href;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
{isHidden ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={searchTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={site.socialImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.twitterHandle} />
<meta name="twitter:title" content={searchTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={site.socialImageAlt} />
