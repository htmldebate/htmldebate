---
// The hero that opens each page: a label, a two-part headline over the brand bloom, and a standfirst. `display` sets the
// headline at the site's largest size, for the home page.
interface Props {
    readonly label?: string;
    readonly title: string;
    readonly highlight: string;
    readonly lead: string;
    readonly display?: boolean;
}

const { label, title, highlight, lead, display = false }: Props = Astro.props;
---
<section class:list={['hero-bloom page-hero', { 'is-display': display }]} aria-labelledby="page-title">
    <div class="page-hero-copy">
        {label !== undefined && <p class="label rise">{label}</p>}
        <h1 id="page-title" class:list={['rise', { display }]}>
            {title}{' '}
            <span class="gradient-text">{highlight}</span>
        </h1>
        <p class="lead rise rise-2">{lead}</p>
        {Astro.slots.has('actions') && <div class="button-pair rise rise-3"><slot name="actions" /></div>}
    </div>
</section>

<style>
    .page-hero {
        padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) clamp(4.5rem, 3rem + 6vw, 8.5rem);
        overflow: clip;
    }

    .page-hero.is-display {
        padding-block: clamp(4rem, 3rem + 5vw, 7.5rem) clamp(5rem, 3.5rem + 7vw, 10rem);
    }

    .page-hero-copy {
        display: grid;
        gap: 1.4rem;
        justify-items: center;
        width: min(100% - 2 * var(--tile-gap) - 1rem, var(--container-wide));
        margin-inline: auto;
        text-align: center;
    }

    .page-hero h1 .gradient-text {
        display: block;
    }

    /* Wider than other standfirsts, and in the full text colour, because the bloom reaches up behind it. */
    .page-hero .lead {
        max-width: 56rem;
        color: var(--text);
        text-wrap: balance;
    }

    .page-hero .button-pair {
        margin-top: 0.6rem;
    }

    /* Bare text on the strongest part of the bloom. */
    .page-hero :global(.button-ghost) {
        --button-text: var(--text-on-bloom);
    }
</style>
