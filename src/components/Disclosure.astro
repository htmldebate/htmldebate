---
import Icon from './Icon.astro';

// A section that folds away: a native <details>, so it opens and closes without JavaScript. Sections with the same `name`
// are exclusive, so opening one closes the others. The caret sits at the end and turns over when it's open. Set
// --disclosure-bg to change its colour.
interface Props {
    readonly name?: string;
    readonly class?: string;
}

const { name, class: className = '' }: Props = Astro.props;
---
<details class:list={['disclosure', className]} name={name}>
    <summary>
        <span><slot name="summary" /></span>
        <Icon name="caret-down-bold" class="disclosure-caret" />
    </summary>
    <div class="disclosure-body"><slot /></div>
</details>

<style>
    .disclosure {
        width: 100%;
        border-radius: var(--radius);
        corner-shape: var(--corner-shape);
        background: var(--disclosure-bg, var(--surface-alt));
        overflow: hidden;
    }

    .disclosure summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 1rem;
        color: var(--heading);
        font-size: var(--text-base);
        font-weight: 500;
        list-style: none;
        cursor: pointer;
    }

    /* The browser's own triangle: Safari's, then everyone else's. */
    .disclosure summary::-webkit-details-marker {
        display: none;
    }

    .disclosure summary::marker {
        content: '';
    }

    /* Inset, so the rounded corners' clipping doesn't cut the outline off. */
    .disclosure summary:focus-visible {
        outline-offset: -2px;
    }

    .disclosure :global(.disclosure-caret) {
        color: var(--text-muted);
        transition: rotate var(--transition);
    }

    .disclosure[open] > summary :global(.disclosure-caret) {
        rotate: 180deg;
    }

    .disclosure-body {
        padding: 0 1rem 1rem;
        color: var(--text-muted);
    }
</style>
