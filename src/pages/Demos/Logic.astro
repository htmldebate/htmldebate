---
import DemoLayout from '../../layouts/DemoLayout.astro';

const andExample: string = `.gate-and:has(.a:checked):has(.b:checked) .output {
    --bit: "1";
}`;
---
<DemoLayout path="/Demos/Logic">
    <div slot="demo" class="gates">
        <div class="gate gate-and">
            <p class="gate-name">AND</p>
            <input class="bit a" type="checkbox" id="and-a" /><label for="and-a"><span class="visually-hidden">AND, input A</span></label>
            <input class="bit b" type="checkbox" id="and-b" /><label for="and-b"><span class="visually-hidden">AND, input B</span></label>
            <output class="output" for="and-a and-b"></output>
            <p class="gate-rule">1 when A <em>and</em> B are 1</p>
        </div>
        <div class="gate gate-or">
            <p class="gate-name">OR</p>
            <input class="bit a" type="checkbox" id="or-a" /><label for="or-a"><span class="visually-hidden">OR, input A</span></label>
            <input class="bit b" type="checkbox" id="or-b" /><label for="or-b"><span class="visually-hidden">OR, input B</span></label>
            <output class="output" for="or-a or-b"></output>
            <p class="gate-rule">1 when A <em>or</em> B (or both) is 1</p>
        </div>
        <div class="gate gate-xor">
            <p class="gate-name">XOR</p>
            <input class="bit a" type="checkbox" id="xor-a" /><label for="xor-a"><span class="visually-hidden">XOR, input A</span></label>
            <input class="bit b" type="checkbox" id="xor-b" /><label for="xor-b"><span class="visually-hidden">XOR, input B</span></label>
            <output class="output" for="xor-a xor-b"></output>
            <p class="gate-rule">1 when exactly one of A and B is 1</p>
        </div>
        <div class="gate gate-nand">
            <p class="gate-name">NAND</p>
            <input class="bit a" type="checkbox" id="nand-a" /><label for="nand-a"><span class="visually-hidden">NAND, input A</span></label>
            <input class="bit b" type="checkbox" id="nand-b" /><label for="nand-b"><span class="visually-hidden">NAND, input B</span></label>
            <output class="output" for="nand-a nand-b"></output>
            <p class="gate-rule">0 only when A and B are both 1</p>
        </div>
        <div class="gate gate-nor">
            <p class="gate-name">NOR</p>
            <input class="bit a" type="checkbox" id="nor-a" /><label for="nor-a"><span class="visually-hidden">NOR, input A</span></label>
            <input class="bit b" type="checkbox" id="nor-b" /><label for="nor-b"><span class="visually-hidden">NOR, input B</span></label>
            <output class="output" for="nor-a nor-b"></output>
            <p class="gate-rule">1 only when A and B are both 0</p>
        </div>
        <div class="gate gate-xnor">
            <p class="gate-name">XNOR</p>
            <input class="bit a" type="checkbox" id="xnor-a" /><label for="xnor-a"><span class="visually-hidden">XNOR, input A</span></label>
            <input class="bit b" type="checkbox" id="xnor-b" /><label for="xnor-b"><span class="visually-hidden">XNOR, input B</span></label>
            <output class="output" for="xnor-a xnor-b"></output>
            <p class="gate-rule">1 when A and B are the same</p>
        </div>
        <div class="gate gate-not">
            <p class="gate-name">NOT</p>
            <input class="bit a" type="checkbox" id="not-a" /><label for="not-a"><span class="visually-hidden">NOT, input A</span></label>
            <span class="bit-gap" aria-hidden="true"></span>
            <output class="output" for="not-a"></output>
            <p class="gate-rule">The opposite of A</p>
        </div>
    </div>

    <p>
        Click the switches on the left of each row to set inputs A and B to 0 or 1. The tile on the right is the gate's
        output, worked out by CSS.
    </p>

    <h2>How it works</h2>
    <p>
        Each switch is an ordinary checkbox, hidden behind a label drawn as a 0 or a 1. A ticked box is a 1; an empty one
        is a 0. That's HTML's part: it remembers the inputs.
    </p>
    <p>
        CSS's part is the logic. Each gate is one or two rules that test the boxes with <code>:checked</code>,
        <code>:not(:checked)</code> and <code>:has()</code>. AND, for example, is a single rule: if this gate has a
        checked A and a checked B, its output is 1.
    </p>
    <pre><code>{andExample}</code></pre>
    <p>
        OR is two rules, one for each input, because a list of rules already behaves as "or": either can switch the
        output on. NOT, NAND and NOR turn on when boxes are <em>not</em> checked.
    </p>

    <h2>Why it matters</h2>
    <p>
        These seven gates are the vocabulary of digital electronics. NAND alone is enough to build every other gate, and
        from gates come adders, comparators and, eventually, a computer's processor. A processor needs two more things:
        memory to hold its results, and a clock to move it from one step to the next. Here, the checkboxes are the
        memory, and you are the clock.
    </p>
</DemoLayout>

<style>
    .gates {
        display: grid;
        gap: 0.75rem;
    }

    .gate {
        display: grid;
        grid-template-columns: 4.5rem repeat(3, 3.5rem) 1fr;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border-radius: var(--radius-lg);
        corner-shape: var(--corner-shape);
        background: var(--surface-alt);
    }

    @media (max-width: 40rem) {
        .gate {
            grid-template-columns: 4rem repeat(3, 3rem);
        }

        .gate-rule {
            grid-column: 1 / -1;
        }
    }

    .gate-name {
        color: var(--heading);
        font-family: var(--font-mono);
        font-weight: 600;
    }

    .gate-rule {
        color: var(--text-muted);
        font-size: var(--text-sm);
    }

    /* The checkbox stays in the page, so it can be focused and read out, but out of sight behind its label. */
    .bit {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }

    .bit + label,
    .output {
        --bit: '0';
        display: grid;
        place-items: center;
        aspect-ratio: 1;
        border-radius: var(--radius);
        corner-shape: var(--corner-shape);
        background: var(--surface);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--text-xl);
        font-weight: 600;
        box-shadow: var(--edge-shadow), var(--shadow-sm);
        --edge-top: var(--edge-light);
        --edge-bottom: var(--edge-dark);
    }

    .bit + label {
        cursor: pointer;
    }

    .bit + label::before,
    .output::before {
        content: var(--bit);
    }

    .bit:checked + label {
        --bit: '1';
        background: var(--brand-blue);
        color: #fff;
    }

    .bit:focus-visible + label {
        outline: 2px solid var(--focus);
        outline-offset: 2px;
    }

    .output {
        box-shadow: inset 0 0 0 2px var(--border-strong);
    }

    /* The gates. Each rule says when a gate's output is 1; otherwise it stays 0. */
    .gate-and:has(.a:checked):has(.b:checked) .output,
    .gate-or:has(.a:checked) .output,
    .gate-or:has(.b:checked) .output,
    .gate-xor:has(.a:checked):has(.b:not(:checked)) .output,
    .gate-xor:has(.a:not(:checked)):has(.b:checked) .output,
    .gate-nand:has(.a:not(:checked)) .output,
    .gate-nand:has(.b:not(:checked)) .output,
    .gate-nor:has(.a:not(:checked)):has(.b:not(:checked)) .output,
    .gate-xnor:has(.a:checked):has(.b:checked) .output,
    .gate-xnor:has(.a:not(:checked)):has(.b:not(:checked)) .output,
    .gate-not:has(.a:not(:checked)) .output {
        --bit: '1';
        background: var(--brand-teal);
        color: #000;
        box-shadow: var(--shadow-sm);
    }
</style>
