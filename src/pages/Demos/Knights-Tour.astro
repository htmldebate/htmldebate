---
import { buildKnightsTourCss } from '../../demos/knights-tour/build-knights-tour-css';
import { knightMoves } from '../../demos/knights-tour/knight-moves';
import DemoLayout from '../../layouts/DemoLayout.astro';

const size: number = 5;
const squareCount: number = size * size;
const moves: ReadonlyArray<number> = Array.from({ length: squareCount }, (_: unknown, index: number): number => index + 1);
const squares: ReadonlyArray<number> = Array.from({ length: squareCount }, (_: unknown, index: number): number => index);

// The rules of the tour, as CSS: written at build time by src/demos/knights-tour.
const tourCss: string = buildKnightsTourCss(size);
const ruleCount: number = tourCss.split('\n').filter((line: string): boolean => line.startsWith('.tour')).length;

function placement(square: number): string {
    return `grid-area: ${String(Math.floor(square / size) + 1)} / ${String((square % size) + 1)}`;
}

// Squares are named as on a chessboard: files a to e from the left, ranks 5 to 1 from the top.
function squareName(square: number): string {
    return `${'abcde'.charAt(square % size)}${String(size - Math.floor(square / size))}`;
}

function cellClasses(move: number, square: number): string {
    const from: ReadonlyArray<string> = knightMoves(square, size).map((origin: number): string => `from-${String(origin)}`);

    return ['cell', `move-${String(move)}`, `square-${String(square)}`, ...from].join(' ');
}

const ruleExample: string = `/* If move 3 landed on square 12, offer move 4
   on every square a knight can reach from 12 */
.tour:has([name="m3"][value="12"]:checked) .move-4.from-12 {
    display: grid;
}`;
---
<DemoLayout path="/Demos/Knights-Tour">
    <form slot="demo" class="tour" aria-label="Knight's tour">
        <p class="status" aria-live="polite"></p>

        <div class="board">
            {squares.map((square: number) => (
                <span class:list={['tile', { 'is-dark': (Math.floor(square / size) + (square % size)) % 2 === 0 }]} style={placement(square)} aria-hidden="true"></span>
            ))}
            {moves.map((move: number) => squares.map((square: number) => (
                <label class={cellClasses(move, square)} style={placement(square)}>
                    <input type="radio" name={`m${String(move)}`} value={String(square)} />
                    <span class="visually-hidden">Move {move}: {squareName(square)}</span>
                    <span class="number" aria-hidden="true">{move}</span>
                    <span class="knight" aria-hidden="true">♞</span>
                </label>
            )))}
        </div>

        <div class="tour-footer">
            <p class="visited" aria-live="polite"></p>
            <button class="button" type="reset">Start again</button>
        </div>
    </form>
    <Fragment set:html={`<style>${tourCss}</style>`} />

    <p>
        Place the knight on any square, then keep moving it the way a knight moves in chess: two squares one way and one
        the other. The aim is to visit all {squareCount} squares, each exactly once. Only legal moves are offered, and
        each square you've visited shows the move that reached it.
    </p>
    <p>
        A hint: a tour of this board can only start on one of the darker squares, the ones the same colour as the corners.
        A corner is a good place to begin.
    </p>

    <h2>How it works</h2>
    <p>
        The board works like <a href="/Demos/Noughts-And-Crosses">noughts and crosses</a>: one group of radio buttons per
        move, with an option for every square. Each option knows which squares a knight could have come from, and CSS
        uses that to offer only the legal moves:
    </p>
    <pre><code>{ruleExample}</code></pre>
    <p>
        Other rules close moves that have been made, hide squares that have been visited, put the knight on the latest
        square, and announce a finished tour. A CSS counter adds up the visited squares. In all, it's {ruleCount} rules,
        written by a small program when the site is built, which tests check against an ordinary list of knight's moves.
    </p>

    <h2>Checking, not searching</h2>
    <p>
        This demo shows the gap between checking and searching most clearly. CSS checks every move you make, instantly
        and without fail. But this board can't find a tour for you, or even warn you that a move leads to a dead end.
        Finding a tour means trying a move, following it until you're stuck, going back and trying another: a search,
        with memory of what's been tried. Here, HTML has the memory, but only you do the going back.
    </p>
    <p>
        That's a limit of rules like these, not of CSS itself. With the newest features, CSS can run an emulated processor
        by itself (<a href="/Together#limit">x86CSS, in part 4</a>), and a processor can run a program that searches. But
        look at the difference in effort: checking a tour takes a few hundred rules anyone could read, while searching for
        one takes building a computer first. A programming language does it in a dozen lines.
    </p>
    <p>
        Telling you you're stuck would be possible, but it would need a rule for every square at every move, checking all
        of that square's neighbours, and the stylesheet would balloon. So when no squares are highlighted, the knight is
        stuck, and it's time to start again.
    </p>
</DemoLayout>

<style>
    .tour {
        display: grid;
        gap: 1.25rem;
        justify-items: center;
        counter-reset: visited;
    }

    .status {
        max-width: 32rem;
        color: var(--heading);
        font-size: var(--text-lg);
        font-weight: 600;
        text-align: center;
    }

    .status::before {
        content: 'Click any square to place the knight.';
    }

    .board {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 4.5rem));
        grid-template-rows: repeat(5, minmax(0, 4.5rem));
        gap: 3px;
        padding: 3px;
        border-radius: var(--radius);
        background: var(--border-strong);
    }

    .tile {
        aspect-ratio: 1;
        border-radius: 3px;
        background: var(--surface);
        corner-shape: round;
    }

    .tile.is-dark {
        background: var(--surface-alt);
    }

    /* A cell is hidden until a rule offers it as a legal move, or until it's been visited. */
    .cell {
        position: relative;
        display: none;
        place-items: center;
        border-radius: 3px;
        corner-shape: round;
        cursor: pointer;
    }

    /* An offered move: a dot in the middle of the square. */
    .cell:not(:has(:checked))::before {
        content: '';
        width: 0.9rem;
        aspect-ratio: 1;
        border-radius: 50%;
        corner-shape: round;
        background: var(--brand-amber);
    }

    .cell:not(:has(:checked)):hover {
        background: color-mix(in srgb, var(--brand-amber) 30%, transparent);
    }

    .cell:has(:checked) {
        display: grid;
        background: color-mix(in srgb, var(--brand-blue) 35%, transparent);
        cursor: default;
    }

    .cell input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }

    .tour input:checked {
        counter-increment: visited;
    }

    .cell:has(:focus-visible) {
        outline: 2px solid var(--focus);
        outline-offset: -2px;
    }

    .number,
    .knight {
        grid-area: 1 / 1;
        color: var(--heading);
        font-family: var(--font-mono);
        font-weight: 600;
    }

    .number {
        display: none;
    }

    .cell:has(:checked) .number {
        display: inline;
    }

    .knight {
        display: none;
        font-size: 2.5rem;
        line-height: 1;
    }

    .tour-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 1rem 2rem;
    }

    .visited {
        color: var(--text-muted);
        font-weight: 500;
    }

    .visited::before {
        content: 'Squares visited: ' counter(visited) ' of 25';
    }
</style>
