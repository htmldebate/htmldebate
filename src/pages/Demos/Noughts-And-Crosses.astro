---
import { buildNoughtsAndCrossesCss } from '../../demos/noughts-and-crosses/build-noughts-and-crosses-css';
import { playerForMove } from '../../demos/noughts-and-crosses/player-for-move';
import Disclosure from '../../components/Disclosure.astro';
import DemoLayout from '../../layouts/DemoLayout.astro';

const moves: ReadonlyArray<number> = [1, 2, 3, 4, 5, 6, 7, 8, 9];
const squares: ReadonlyArray<number> = [0, 1, 2, 3, 4, 5, 6, 7, 8];
const squareNames: ReadonlyArray<string> = [
    'top left', 'top middle', 'top right',
    'middle left', 'centre', 'middle right',
    'bottom left', 'bottom middle', 'bottom right',
];

// The rules of the game, as CSS: written at build time by src/demos/noughts-and-crosses.
const gameCss: string = buildNoughtsAndCrossesCss();

function placement(square: number): string {
    return `grid-area: ${String(Math.floor(square / 3) + 1)} / ${String((square % 3) + 1)}`;
}

const ruleCount: number = gameCss.split('{').length - 1;

// The real rules that mention something, so what's shown is what runs.
function rulesWith(...parts: ReadonlyArray<string>): string {
    return gameCss
        .split('\n')
        .filter((line: string): boolean => line.startsWith('.game') && parts.every((part: string): boolean => line.includes(part)))
        .join('\n\n')
        .replaceAll(' { ', ' {\n    ')
        .replaceAll('; }', ';\n}');
}

const moveExample: string = `<label class="cell move-3 square-4">
    <input type="radio" name="m3" value="4" class="x">
    Put X in the centre
</label>`;
const turnExample: string = rulesWith('.move-3 {');
const takenExample: string = rulesWith('.square-4:not(:has(:checked))');
const statusExample: string = rulesWith('.game:has([name="m1"]:checked) .status');
const winExample: string = rulesWith('.x[value="0"]', '.x[value="4"]', '.x[value="8"]');
const drawExample: string = rulesWith('a draw');

const resetExample: string = `<button class="button" type="reset">New game</button>`;
---
<DemoLayout path="/Demos/Noughts-And-Crosses">
    <Fragment slot="what">
        <p>
            Two players, one screen: X goes first, then take turns. The game refuses a square that's already taken, says
            whose turn it is, and spots a line of three or a draw. "New game" clears the board.
        </p>
    </Fragment>

    <Fragment slot="demo">
        <form class="game" aria-label="Noughts and crosses">
            <p class="status" aria-live="polite"></p>

            <div class="board">
                {squares.map((square: number) => <span class="tile" style={placement(square)} aria-hidden="true"></span>)}
                {moves.map((move: number) => squares.map((square: number) => (
                    <label class={`cell move-${String(move)} square-${String(square)}`} style={placement(square)}>
                        <input type="radio" name={`m${String(move)}`} value={String(square)} class={playerForMove(move)} />
                        <span class="visually-hidden">Put {playerForMove(move).toUpperCase()} in the {squareNames[square]}</span>
                        <span class="mark" aria-hidden="true">{playerForMove(move).toUpperCase()}</span>
                    </label>
                )))}
            </div>

            <button class="button" type="reset">New game</button>
        </form>
        <Fragment set:html={`<style>${gameCss}</style>`} />
    </Fragment>

    <Fragment slot="how">
        <p>
            The game's memory is nine groups of radio buttons, one group for each move, with an option in each group for every
            square. Radio buttons suit a game well: a group can only have one choice, so a move can only go in one square. Each
            option is hidden inside a label, and the labels are laid over the board.
        </p>
        <Disclosure>
            <Fragment slot="summary">The HTML</Fragment>
            <pre><code>{moveExample}</code></pre>
        </Disclosure>

        <h3>Taking turns</h3>
        <p>
            The options for a move appear once the move before it has been made, and disappear once it has been made itself, so
            only one move is ever open. Odd moves belong to X and even moves to O, so the board never has to count whose turn it
            is. It only has to know which move comes next.
        </p>
        <Disclosure>
            <Fragment slot="summary">Taking turns source</Fragment>
            <pre><code>{turnExample}</code></pre>
        </Disclosure>

        <h3>Keeping squares closed</h3>
        <p>
            Once a square has been played, whichever move played it, it's hidden from every later one. Hiding a label hides the
            radio button inside it too, so a taken square can't be chosen with the keyboard either. The rule leaves out the label
            that was chosen, because that's the one showing the mark.
        </p>
        <Disclosure>
            <Fragment slot="summary">Keeping squares closed source</Fragment>
            <pre><code>{takenExample}</code></pre>
        </Disclosure>

        <h3>Saying whose turn it is</h3>
        <p>
            The message above the board is empty in the HTML, and CSS writes it. There's a rule for each move, saying who plays
            next. They come in order, so as the game goes on, each one takes over from the last.
        </p>
        <p>
            It's also where having no JavaScript costs something. A script could ask a screen reader to announce each turn. Text
            that CSS writes can be read, but it may not be announced when it changes, so a screen reader user may need to go
            back to the message after each move.
        </p>
        <Disclosure>
            <Fragment slot="summary">Saying whose turn it is source</Fragment>
            <pre><code>{statusExample}</code></pre>
        </Disclosure>

        <h3>Spotting a win</h3>
        <p>
            There are eight lines of three, and each has its own rules for X and for O. A rule looks for three of the same mark
            by testing for three checked options at once. When it matches, it announces the winner, hides every square that
            hasn't been played, and marks the line. These are the rules for X on the diagonal from top left.
        </p>
        <Disclosure>
            <Fragment slot="summary">Spotting a win source</Fragment>
            <pre><code>{winExample}</code></pre>
        </Disclosure>

        <h3>Spotting a draw</h3>
        <p>
            If the ninth move has been made, the board is full. If that move also completes a line, the win is announced
            instead: its rule tests for three things rather than one, which makes it more specific, so it takes precedence.
        </p>
        <Disclosure>
            <Fragment slot="summary">Spotting a draw source</Fragment>
            <pre><code>{drawExample}</code></pre>
        </Disclosure>

        <h3>Starting again</h3>
        <p>
            The "New game" button is HTML. A reset button puts every input in its form back the way it started, which unticks
            every move, and the board goes back to the beginning.
        </p>
        <Disclosure>
            <Fragment slot="summary">Starting again source</Fragment>
            <pre><code>{resetExample}</code></pre>
        </Disclosure>

        <h3>Written by a program</h3>
        <p>
            In all, it takes {ruleCount} rules, written by a small program when the site is built rather than by hand. Every one is
            a plain CSS rule. The program just saves typing out the same pattern for every move, square and line, and tests check
            that all sixteen winning lines are there.
        </p>

        <h3>The end result</h3>
        <p>
            Two players can play a whole game. Every move is legal, every win and draw is spotted, and it ends when it should.
        </p>
    </Fragment>

    <Fragment slot="why">
        <p>
            A game has to remember what's happened and decide what's allowed next, which is the third of the
            <a href="/Programming#tests">four tests</a>. HTML on its own can't decide, and CSS on its own, as most people write it,
            can't remember. Together they run a whole game, rules and all.
        </p>
        <p>
            What it doesn't do is play against you. A computer opponent has to look ahead, imagining moves and their replies, and choose
            the best: a search, which rules like these don't do. They can referee a game, not play one.
        </p>
        <p>
            There are two ways round that, and neither is simple. Noughts and crosses is small enough that a program could
            work out the best reply to every possible position in advance and write each one out as a CSS rule: a lookup
            table, which plays perfectly without thinking at all. Or, with the newest CSS, an emulated processor like
            <a href="/Together#limit">x86CSS</a> could run a game-playing program for real. Both show the same thing: in CSS,
            playing a game is possible, but it takes far more than refereeing one.
        </p>
    </Fragment>
</DemoLayout>

<style>
    .game {
        display: grid;
        gap: 1.25rem;
        justify-items: center;
    }

    .status {
        color: var(--heading);
        font-size: var(--text-xl);
        font-weight: 600;
    }

    .status::before {
        content: 'X to play';
    }

    .board {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 6rem));
        grid-template-rows: repeat(3, minmax(0, 6rem));
        gap: 0.5rem;
    }

    .tile {
        border-radius: var(--radius);
        background: var(--surface-alt);
    }

    /* A cell is hidden until a rule opens it for the move in play, or until it's been chosen. */
    .cell {
        --winning: 0;
        position: relative;
        display: none;
        place-items: center;
        border-radius: var(--radius);
        background: color-mix(in srgb, var(--brand-teal) calc(var(--winning) * 10%), transparent);
        box-shadow: inset 0 0 0 calc(var(--winning) * 3px) var(--brand-teal);
        cursor: pointer;
    }

    .cell:has(:checked) {
        display: grid;
        cursor: default;
    }

    .cell input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }

    .cell:has(:focus-visible) {
        outline: 2px solid var(--focus);
        outline-offset: 2px;
    }

    .mark {
        font-size: 3.25rem;
        font-weight: 700;
        line-height: 1;
        opacity: 0;
    }

    .cell:has(:checked) .mark {
        opacity: 1;
    }

    /* A faint preview of the mark that would go here. */
    .cell:not(:has(:checked)):hover .mark {
        opacity: 0.25;
    }

    .cell:has(.x) .mark {
        color: var(--ink-blue);
    }

    .cell:has(.o) .mark {
        color: var(--ink-rose);
    }
</style>
