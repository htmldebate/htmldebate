---
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import type { DebatePart } from '../config/debate-part';
import { debateParts } from '../config/debate-parts';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title={site.name} description={site.description} path="/">
    <PageHero
        display
        title="Is HTML a"
        highlight="programming language?"
        lead="It's one of the internet's longest-running arguments. Rather than pick a side, this site sets out what programming means, tests HTML and CSS against it, and lets the demos speak for themselves."
    >
        <Fragment slot="actions">
            <Button href={debateParts[0]?.path ?? '/'} variant="primary" size="large">Start reading</Button>
            <Button href="/Together" variant="ghost" size="large" trailingIcon="arrow-right-bold">See the demos</Button>
        </Fragment>
    </PageHero>

    <section class="section" aria-labelledby="parts-title">
        <div class="container-wide">
            <SectionHeader id="parts-title" eyebrow="The case" title="Five parts," highlight="one question.">
                <p>
                    Each part builds on the one before. We agree on the tests first, try HTML and CSS against them
                    separately, then put them together and see how far they go.
                </p>
            </SectionHeader>

            <ol class="grid grid-3 parts" role="list">
                {debateParts.map((part: DebatePart) => (
                    <li class="reveal-scale">
                        <a class="tile part-tile" href={part.path}>
                            <span class="label">Part {part.number}</span>
                            <h3>{part.title} {part.highlight}</h3>
                            <p>{part.summary}</p>
                            <span class="link-cta">Read part {part.number}</span>
                        </a>
                    </li>
                ))}
                <li class="reveal-scale">
                    <a class="tile part-tile part-tile-sources" href="/Sources">
                        <span class="label label-muted">Further reading</span>
                        <h3>Sources</h3>
                        <p>The articles, talks and definitions behind the debate: who said what, and which side they came down on.</p>
                        <span class="link-cta">See the sources</span>
                    </a>
                </li>
            </ol>
        </div>
    </section>

    <section class="section tone-alt" aria-labelledby="no-script-title">
        <div class="container-wide split">
            <SectionHeader id="no-script-title" eyebrow="The rules" title="Zero JavaScript." highlight="Really.">
                <p>
                    Everything on this site, from the menu to the demos, is built from HTML and CSS. Your browser is told to
                    refuse scripts outright, and the site won't even build if one slips in. The site itself is part of the
                    evidence.
                </p>
            </SectionHeader>

            <ul class="grid rules" role="list">
                <li class="surface rule">
                    <h3>The menu</h3>
                    <p>On a phone, the menu opens and closes with HTML's <code>popover</code> attribute. No script toggles it.</p>
                </li>
                <li class="surface rule">
                    <h3>Light and dark</h3>
                    <p>The colours follow your device's setting through a CSS media query, so there's no switch to remember.</p>
                </li>
                <li class="surface rule">
                    <h3>The demos</h3>
                    <p>Every demo keeps its state in checkboxes and radio buttons, and CSS decides what happens next.</p>
                </li>
            </ul>
        </div>
    </section>
</BaseLayout>

<style>
    .parts {
        counter-reset: none;
    }

    .parts > li {
        display: grid;
    }

    .part-tile {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        gap: 0.85rem;
        padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    }

    .part-tile h3 {
        font-size: var(--text-2xl);
        font-weight: 600;
    }

    .part-tile p {
        color: var(--text-muted);
    }

    .part-tile-sources {
        background: var(--surface-alt);
    }

    .split {
        display: grid;
        gap: 2rem;
    }

    @media (min-width: 64rem) {
        .split {
            grid-template-columns: 1fr 1fr;
            align-items: start;
            column-gap: 4rem;
        }

        .split :global(.section-header) {
            margin-bottom: 0;
        }
    }

    .rules {
        gap: var(--tile-gap);
    }

    .rule {
        display: grid;
        gap: 0.5rem;
        padding: 1.5rem 1.75rem;
    }

    .rule p {
        color: var(--text-muted);
    }

    .rule code {
        font-family: var(--font-mono);
        font-size: 0.9em;
    }
</style>
