---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Sources" description="The articles, talks and definitions behind the HTML debate, and which side each came down on." path="/Sources">
    <PageHero
        label="Further reading"
        title="Sources and"
        highlight="further reading"
        lead="The articles, talks and definitions behind the debate: who said what, and whether they came down for, against, or somewhere in between."
    />

    <section class="section" aria-labelledby="plan-title">
        <div class="container-narrow">
            <div class="surface plan">
                <p class="label">Being rewritten</p>
                <h2 id="plan-title">Coming across from the original site</h2>
                <p>
                    The original site's references, each with a short summary and where its author stands, checked so every
                    link still works.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .plan {
        display: grid;
        gap: 1rem;
        padding: clamp(1.75rem, 1.4rem + 1.5vw, 2.75rem);
    }

    .plan h2 {
        font-size: var(--text-3xl);
    }
</style>
