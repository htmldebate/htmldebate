---
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="There's no page at this address." path="/404">
    <PageHero label="404" title="This page" highlight="doesn't exist." lead="It may have moved when the site was rebuilt. The debate starts from the beginning.">
        <Fragment slot="actions">
            <Button href="/" variant="primary">Go to the introduction</Button>
        </Fragment>
    </PageHero>
</BaseLayout>
