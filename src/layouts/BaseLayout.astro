---
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-400-italic.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/effects.css';
import '../styles/prose.css';

import poppinsRegular from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppinsSemiBold from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';

import Seo from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StructuredData from '../components/StructuredData.astro';
import { PageKind } from '../config/page-kind';

interface Props {
    readonly title: string;
    readonly searchTitle?: string;
    readonly description: string;
    readonly path: string;
    readonly kind?: PageKind;
    // Kept out of search results.
    readonly isHidden?: boolean;
}

const { title, searchTitle = title, description, path, kind = PageKind.Other, isHidden = false }: Props = Astro.props;

// The browser refuses to run any script at all, even one that slipped past the build's check (forbid-scripts).
// Inline styles are allowed: CSS is what the site demonstrates, and the quine shows its own <style> element.
const contentSecurityPolicy: string = [
    "default-src 'self'",
    "script-src 'none'",
    "style-src 'self' 'unsafe-inline'",
    "img-src 'self' data:",
    "font-src 'self'",
    "connect-src 'none'",
    "frame-src 'none'",
    "object-src 'none'",
    "form-action 'self'",
    "base-uri 'self'",
    'upgrade-insecure-requests',
].join('; ');
---
<!doctype html>
<html lang="en-GB">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta http-equiv="content-security-policy" content={contentSecurityPolicy} />
        <meta name="color-scheme" content="light dark" />
        <meta name="theme-color" content="#d8dde2" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#212529" media="(prefers-color-scheme: dark)" />
        <meta name="generator" content={Astro.generator} />

        <link rel="icon" sizes="48x48" type="image/png" href="/onixlabs/images/logo/logo-orb-48.png" />
        <link rel="icon" sizes="96x96" type="image/png" href="/onixlabs/images/logo/logo-orb-96.png" />
        <link rel="icon" sizes="any" type="image/svg+xml" href="/onixlabs/images/logo/logo-orb.svg" />
        <link rel="apple-touch-icon" href="/onixlabs/images/logo/logo-orb-180.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <link rel="preload" href={poppinsRegular} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={poppinsSemiBold} as="font" type="font/woff2" crossorigin />

        <Seo searchTitle={searchTitle} description={description} path={path} isHidden={isHidden} />
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to main content</a>
        <SiteHeader />
        <main id="main-content" tabindex="-1">
            <slot />
        </main>
        <SiteFooter />
        {!isHidden && <StructuredData kind={kind} name={title} searchTitle={searchTitle} description={description} path={path} />}
    </body>
</html>
